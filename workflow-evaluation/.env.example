# Export these variables in your shell; the app does not auto-load .env files.
# Leave key empty for free offline fixture mode. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
API_TIMEOUT_SECONDS=20
DATABASE_PATH=data/dashboard.sqlite
# Explicit assumed standard uncached pricing; verify before live use.
INPUT_USD_PER_MILLION=0.40
OUTPUT_USD_PER_MILLION=1.60
